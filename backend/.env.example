PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/200m_app
JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=1d
DEV_SEED_ADMIN_NAME=Development Admin
DEV_SEED_ADMIN_EMAIL=dev-admin@200m.local
DEV_SEED_ADMIN_PASSWORD=DevAdmin@12345

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=example@example.com
MAIL_PASS=yourpassword
MAIL_FROM=no-reply@200m.com
CLIENT_URL=http://localhost:5173
RANK_CHECKER_SERVICE_URL=http://127.0.0.1:4001
RANK_PROXY_SHARED_SECRET=replace_with_shared_rank_proxy_secret
SCREENSHOT_TAKER_SERVICE_URL=http://127.0.0.1:4010
SCREENSHOT_TAKER_PROXY_SECRET=replace_with_shared_screenshot_proxy_secret
SCREENSHOT_PROXY_TIMEOUT_MS=60000
SCREENSHOT_PROXY_LIVE_TIMEOUT_MS=120000
SCREENSHOT_SYNC_TIMEOUT_MS=15000
SHORT_LINK_CHECKER_SERVICE_URL=http://127.0.0.1:4020
SHORT_LINK_CHECKER_PROXY_SECRET=replace_with_shared_short_link_proxy_secret
SHORT_LINK_PROXY_TIMEOUT_MS=60000
SHORT_LINK_PROXY_CHECK_TIMEOUT_MS=900000
CHECKER_API_KEY=replace_with_money_site_checker_key
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL="gemini-3.1-flash-lite-preview"
SECRET_KEY=

# Reporting task evidence image storage (S3-compatible bucket)
STORAGE_BUCKET_NAME=your-evidence-bucket
STORAGE_BUCKET_REGION=us-east-1
STORAGE_BUCKET_ACCESS_KEY_ID=your_access_key
STORAGE_BUCKET_SECRET_ACCESS_KEY=your_secret_key
# Optional for Cloudflare R2, MinIO, DigitalOcean Spaces, etc.
STORAGE_BUCKET_ENDPOINT=
STORAGE_BUCKET_PUBLIC_URL=
STORAGE_BUCKET_FORCE_PATH_STYLE=false

# Existing DigitalOcean Spaces variable names are also supported:
# DO_SPACES_KEY=your_spaces_key
# DO_SPACES_SECRET=your_spaces_secret
# DO_SPACES_BUCKET=your_space_name
# DO_SPACES_REGION=sgp1
# DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
# DO_SPACES_CDN=https://your-space.sgp1.cdn.digitaloceanspaces.com

# For web push notifications run this in backend to generate VAPID keys:
# node --input-type=module -e "import webpush from 'web-push'; console.log(webpush.generateVAPIDKeys())"
