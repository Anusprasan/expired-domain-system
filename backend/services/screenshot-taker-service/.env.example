PORT=4010
MONGO_URI=mongodb://127.0.0.1:27017/200m-web-app
# Optional. Uses MONGO_URI when empty.
SCREENSHOT_TAKER_MONGO_URI=
# Use mongo/database for production. Use file only for local fallback.
SCREENSHOT_TAKER_STATE_STORAGE=mongo
SCREENSHOT_TAKER_PROXY_SECRET=replace_with_shared_screenshot_proxy_secret
SCREENSHOT_TAKER_DATA_DIR=./data
SCREENSHOT_VIEWPORT_WIDTH=1366
SCREENSHOT_VIEWPORT_HEIGHT=900
SCREENSHOT_NAVIGATION_TIMEOUT_MS=45000
SCREENSHOT_NETWORK_IDLE_TIMEOUT_MS=5000
SCREENSHOT_JOB_TIMEOUT_MS=180000
SCREENSHOT_ORIGINAL_FULL_PAGE=true
SCREENSHOT_FRONTEND_PREVIEW_QUALITY=18
SCREENSHOT_FRONTEND_PREVIEW_FULL_PAGE=false
SCREENSHOT_TELEGRAM_TOP_HALF_ENABLED=false
SCREENSHOT_TELEGRAM_TOP_HALF_RATIO=0.5
SCREENSHOT_TELEGRAM_TOP_HALF_MIN_HEIGHT=320
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
#npx playwright install --with-deps chromium
